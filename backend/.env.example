# Copy to .env and fill these values locally. Never commit .env.
# Leave DATABASE_URL blank to use local SQLite, or set your Supabase
# PostgreSQL session pooler connection string (port 5432).
DATABASE_URL=

# Optional until AI coaching is used. Keep the real key on the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Local development origins; set the real Vercel origin in Render.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
